{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "RpcUrl": "http://localhost:8545",
    "NodeRegistryAddress": "",
    "EpochRootRegistryAddress": "",
    "RelayerPrivateKey": "",
    "RpcProxy": {
      // Limits on the public /v1/rpc proxy (#182). Each client IP gets a token bucket; eth_getLogs
      // costs GetLogsCost tokens. Clients behind one NAT share a bucket. Behind a reverse proxy, list
      // it in TrustedProxies (IPs or CIDRs), or every client shares the proxy's bucket.
      "RateLimit": {
        "Enabled": true,
        "TokensPerSecond": 20,
        "BurstTokens": 200,
        "GetLogsCost": 5,
        "MaxConcurrentRequests": 64,
        "TrustedProxies": []
      }
    }
  }
}
