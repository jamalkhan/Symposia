{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ComputeNode": {
    "DataRoot": "data/compute",
    "NodeIdentityKeyPath": "data/compute/node-identity.pem",
    "PageserverExecutablePath": "pageserver",
    "SafekeeperExecutablePath": "safekeeper",
    "PostgresExecutablePath": "postgres",
    "SupportedPostgresMajorVersion": 16,
    "InstalledExtensions": [],
    "MaxHostedDatabases": 8,
    "CrashDetectionWindowSeconds": 10,
    "RestartBackoffBaseSeconds": 2,
    "MaxRestartAttempts": 5,
    "CrashLoopWindowSeconds": 300
  }
}
