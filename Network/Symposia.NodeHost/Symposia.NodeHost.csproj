<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The hosted role projects each ship an appsettings.json; the Node Host supplies all
         role configuration in-memory, so their copies are irrelevant and may collide. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Symposia.Network.Node\Symposia.Network.Node.csproj" />
    <ProjectReference Include="..\..\Blockchain\Symposia.Blockchain.Gateway\Symposia.Blockchain.Gateway.csproj" />
    <ProjectReference Include="..\..\BlobStorage\Symposia.BlobStorage.StorageNode\Symposia.BlobStorage.StorageNode.csproj" />
    <ProjectReference Include="..\..\Database\Symposia.Database.ComputeNode\Symposia.Database.ComputeNode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Settings\presets.json" />
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Symposia.NodeHost.Tests" />
  </ItemGroup>

</Project>
