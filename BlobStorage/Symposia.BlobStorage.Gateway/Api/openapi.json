{
  "openapi": "3.1.0",
  "info": {
    "title": "Symposia Blob API",
    "version": "1",
    "description": "Symposia-native blob API (issue #203), beside the S3-compatible API over the same buckets and objects. Authenticate every call except this document with AWS Signature V4 (service \"s3\", region = the gateway's region) using the gateway's access keys."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "sigv4": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "AWS4-HMAC-SHA256 SigV4 Authorization header, with x-amz-date and x-amz-content-sha256."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        }
      },
      "Object": {
        "type": "object",
        "properties": {
          "bucket": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "contentType": {
            "type": "string"
          },
          "etag": {
            "type": "string"
          },
          "cid": {
            "type": "string"
          },
          "lastModified": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ObjectMeta": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Object"
          },
          {
            "type": "object",
            "properties": {
              "replicas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "properties": {
          "replication": {
            "type": "string",
            "enum": [
              "quorum",
              "full"
            ],
            "description": "quorum until every target copy has confirmed (#7)."
          },
          "targetCopies": {
            "type": "integer"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "placementGaps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "scheme": {
            "type": "string"
          },
          "shards": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object"
            }
          },
          "pendingReplicas": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "HistoryEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "timestamp": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "api": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "etag": {
            "type": "string"
          },
          "cid": {
            "type": "string"
          },
          "clientIp": {
            "type": "string"
          },
          "accessKeyId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "userAgent": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        }
      }
    }
  },
  "security": [
    {
      "sigv4": []
    }
  ],
  "paths": {
    "/v1/openapi.json": {
      "get": {
        "summary": "This document.",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document."
          }
        }
      }
    },
    "/v1/buckets": {
      "get": {
        "summary": "List buckets.",
        "responses": {
          "200": {
            "description": "{ buckets: [{ name, createdAt }] }"
          }
        }
      }
    },
    "/v1/buckets/{bucket}": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "summary": "Create a bucket (idempotent). S3 naming rules.",
        "responses": {
          "200": {
            "description": "{ name }"
          },
          "400": {
            "description": "InvalidBucketName",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an empty bucket.",
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "404": {
            "description": "NoSuchBucket"
          },
          "409": {
            "description": "BucketNotEmpty"
          }
        }
      }
    },
    "/v1/buckets/{bucket}/objects": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "prefix",
          "in": "query",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "description": "Opaque; the previous page's nextCursor.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          }
        }
      ],
      "get": {
        "summary": "List objects by key, paged.",
        "responses": {
          "200": {
            "description": "{ objects: Object[], nextCursor: string|null }"
          },
          "400": {
            "description": "InvalidArgument"
          },
          "404": {
            "description": "NoSuchBucket"
          }
        }
      }
    },
    "/v1/buckets/{bucket}/objects/{key}": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "key",
          "in": "path",
          "required": true,
          "description": "May contain slashes.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "summary": "Write an object (raw body).",
        "responses": {
          "200": {
            "description": "Object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Object"
                }
              }
            }
          },
          "404": {
            "description": "NoSuchBucket"
          }
        }
      },
      "get": {
        "summary": "Read an object (supports Range). With ?meta, its metadata and replica placement; with ?history, its operation history (#204).",
        "parameters": [
          {
            "name": "meta",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "history",
            "in": "query",
            "allowEmptyValue": true,
            "description": "Operation history, oldest first. Works after the object is deleted; unknown buckets or keys return an empty list. Kept 1 hour on LocalDev, 30 days elsewhere.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "With ?history: ISO 8601 lower bound.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "With ?history: ISO 8601 upper bound.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "operation",
            "in": "query",
            "description": "With ?history: comma-separated insert, update, view, delete.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "With ?history: the previous page's nextCursor.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "With ?history: 1-1000, default 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Object bytes; ObjectMeta with ?meta; { entries: HistoryEntry[], nextCursor } with ?history."
          },
          "206": {
            "description": "Partial content."
          },
          "404": {
            "description": "NoSuchKey"
          }
        }
      },
      "head": {
        "summary": "Object headers only.",
        "responses": {
          "200": {
            "description": "Exists."
          },
          "404": {
            "description": "Missing."
          }
        }
      },
      "delete": {
        "summary": "Delete an object (idempotent).",
        "responses": {
          "204": {
            "description": "Deleted or absent."
          }
        }
      },
      "post": {
        "summary": "?restore: bring back a deleted object within its recovery window. ?retention: set { lockedUntil, legalHold } (#16).",
        "responses": {
          "200": {
            "description": "The object, or its retention"
          },
          "400": {
            "description": "InvalidArgument"
          },
          "404": {
            "description": "NoSuchBucket, NoSuchKey or NoSuchVersion"
          }
        }
      }
    },
    "/v1/buckets/{bucket}/regions": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "prefix",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "Set or read a folder rule instead of the bucket's (#8)."
        }
      ],
      "get": {
        "summary": "The bucket's region assignment (#7): where its new objects are placed. Empty = global.",
        "responses": {
          "200": {
            "description": "{ regions: string[] }"
          },
          "404": {
            "description": "NoSuchBucket (also for another tenant's bucket)"
          }
        }
      },
      "put": {
        "summary": "Set the bucket's region assignment. Applies to writes from now on; network redundancy mode only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "regions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ regions: string[] }"
          },
          "400": {
            "description": "InvalidArgument"
          },
          "404": {
            "description": "NoSuchBucket"
          },
          "409": {
            "description": "RegionsNotEnforced (bootstrap mode)"
          }
        }
      }
    },
    "/v1/buckets/{bucket}/scheme": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "summary": "Choose how new objects are stored (#8): \"replica\" (full copies, default) or \"rs:k+m\" Reed-Solomon shards.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scheme": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ scheme }"
          },
          "400": {
            "description": "InvalidArgument"
          },
          "404": {
            "description": "NoSuchBucket"
          }
        }
      }
    },
    "/v1/buckets/{bucket}/lifecycle": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "The bucket's lifecycle and retention rules (#16).",
        "responses": {
          "200": {
            "description": "BucketLifecycle"
          },
          "404": {
            "description": "NoSuchBucket"
          }
        }
      },
      "put": {
        "summary": "Set versioning, version limits, minimum retention, recovery window (1–365 days) and multipart TTL (1–720 hours).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "versioning": {
                    "type": "boolean"
                  },
                  "maxVersions": {
                    "type": "integer"
                  },
                  "maxVersionAgeDays": {
                    "type": "integer"
                  },
                  "minRetentionDays": {
                    "type": "integer"
                  },
                  "recoveryDays": {
                    "type": "integer"
                  },
                  "multipartTtlHours": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "BucketLifecycle"
          },
          "400": {
            "description": "InvalidArgument"
          },
          "404": {
            "description": "NoSuchBucket"
          }
        }
      }
    },
    "/v1/gc": {
      "get": {
        "summary": "Objects pending physical deletion per bucket, with estimated purge time, and placement warnings, for the caller's tenant (#16).",
        "responses": {
          "200": {
            "description": "{ pendingDeletion, placementWarnings }"
          }
        }
      }
    },
    "/v1/credentials": {
      "get": {
        "summary": "The tenant's credentials (#3). Secrets are never returned after issuance.",
        "responses": {
          "200": {
            "description": "credential[]"
          },
          "403": {
            "description": "Not allowed for this credential"
          },
          "501": {
            "description": "No Credential Authority configured"
          }
        }
      },
      "post": {
        "summary": "Issue a credential: { identity, accessLevel: Read|ReadWrite, bucket?, prefix?, key?, expiresAt?, regionLock?, canManage? }. Never broader than the caller's. The secret is in this response only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ credential, accessKeyId, secretAccessKey }"
          },
          "403": {
            "description": "Not allowed for this credential"
          },
          "501": {
            "description": "No Credential Authority configured"
          }
        }
      }
    },
    "/v1/credentials/{id}/revoke": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Revoke; every gateway refuses it within 60 s.",
        "responses": {
          "200": {
            "description": "{ revoked }"
          },
          "403": {
            "description": "Not allowed for this credential"
          },
          "501": {
            "description": "No Credential Authority configured"
          }
        }
      }
    },
    "/v1/credentials/{id}/rotate": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Issue a replacement with the same configuration and revoke this one, now or after { graceSeconds }.",
        "responses": {
          "200": {
            "description": "{ credential, accessKeyId, secretAccessKey }"
          },
          "403": {
            "description": "Not allowed for this credential"
          },
          "501": {
            "description": "No Credential Authority configured"
          }
        }
      }
    },
    "/v1/policies/{bucket}": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "key",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "Set an object ACL instead of the bucket policy."
        }
      ],
      "put": {
        "summary": "Replace the bucket policy (or object ACL): [{ effect: Allow|Deny, kind: Credential|Tenant|AccessLevel|Identity, principal }]. Explicit deny wins.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Set"
          },
          "403": {
            "description": "Needs a manager credential"
          }
        }
      }
    },
    "/v1/audit": {
      "get": {
        "summary": "The tenant's hash-chained credential audit trail, optionally for one credentialId, paged by after/limit.",
        "responses": {
          "200": {
            "description": "AuditEvent[]"
          },
          "403": {
            "description": "Not allowed for this credential"
          },
          "501": {
            "description": "No Credential Authority configured"
          }
        }
      }
    },
    "/v1/audit/verify": {
      "get": {
        "summary": "Recompute the tenant's audit hash chain.",
        "responses": {
          "200": {
            "description": "{ intact }"
          },
          "403": {
            "description": "Not allowed for this credential"
          },
          "501": {
            "description": "No Credential Authority configured"
          }
        }
      }
    },
    "/v1/account/quota": {
      "get": {
        "summary": "The account's quota and usage (#15). Null limits are unlimited.",
        "responses": {
          "200": {
            "description": "AccountQuota: limit_bytes, used_bytes, reserved_bytes, available_bytes, utilization_pct, platform_imposed_limit_bytes, tenant_self_limit_bytes, effective_limit_bytes, egress_limit_bytes_per_month, free_tier"
          }
        }
      },
      "put": {
        "summary": "Set the tenant's self-imposed account limit; the effective limit is min(platform, self).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tenant_self_limit_bytes": {
                    "type": "integer"
                  }
                },
                "required": [
                  "tenant_self_limit_bytes"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AccountQuota: limit_bytes, used_bytes, reserved_bytes, available_bytes, utilization_pct, platform_imposed_limit_bytes, tenant_self_limit_bytes, effective_limit_bytes, egress_limit_bytes_per_month, free_tier"
          },
          "400": {
            "description": "InvalidArgument"
          }
        }
      }
    },
    "/v1/account/quota/self-limit": {
      "delete": {
        "summary": "Remove the self-imposed limit; the platform-imposed limit still applies.",
        "responses": {
          "200": {
            "description": "AccountQuota: limit_bytes, used_bytes, reserved_bytes, available_bytes, utilization_pct, platform_imposed_limit_bytes, tenant_self_limit_bytes, effective_limit_bytes, egress_limit_bytes_per_month, free_tier"
          }
        }
      }
    },
    "/v1/buckets/{bucket}/quota": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "The bucket's quota and usage (#15).",
        "responses": {
          "200": {
            "description": "BucketQuota: limit_bytes, used_bytes, reserved_bytes, available_bytes, utilization_pct, max_object_count, object_count"
          },
          "404": {
            "description": "NoSuchBucket"
          }
        }
      },
      "put": {
        "summary": "Set the bucket's byte and/or object-count quota, enforced in addition to the account quota.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "limit_bytes": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_object_count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "BucketQuota: limit_bytes, used_bytes, reserved_bytes, available_bytes, utilization_pct, max_object_count, object_count"
          },
          "400": {
            "description": "InvalidArgument"
          },
          "404": {
            "description": "NoSuchBucket"
          }
        }
      },
      "delete": {
        "summary": "Remove the bucket's quota; the account quota still applies.",
        "responses": {
          "204": {
            "description": "Removed"
          },
          "404": {
            "description": "NoSuchBucket"
          }
        }
      }
    }
  }
}
